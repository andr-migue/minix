\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Estado del sistema con el scheduler original del repositorio, antes de aplicar ninguna modificaci\'on. La CPU se encuentra al 98.4\% idle, todos los procesos operan en prioridad base (\texttt  {PRI=7}) y ning\'un proceso consume tiempo de CPU apreciable.}}{12}{figure.1}\protected@file@percent }
\newlabel{fig:baseline}{{1}{12}{Estado del sistema con el scheduler original del repositorio, antes de aplicar ninguna modificaci\'on. La CPU se encuentra al 98.4\% idle, todos los procesos operan en prioridad base (\texttt {PRI=7}) y ning\'un proceso consume tiempo de CPU apreciable}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sistema con el scheduler modificado pero sin los programas de prueba en ejecuci\'on. La CPU se encuentra al 100\% idle y todos los procesos permanecen en prioridad base (\texttt  {PRI=7}), confirmando que el mecanismo no introduce ninguna perturbaci\'on en ausencia de procesos CPU-bound.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:running}{{2}{12}{Sistema con el scheduler modificado pero sin los programas de prueba en ejecuci\'on. La CPU se encuentra al 100\% idle y todos los procesos permanecen en prioridad base (\texttt {PRI=7}), confirmando que el mecanismo no introduce ninguna perturbaci\'on en ausencia de procesos CPU-bound}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Inicio de los tests de validaci\'on y primera penalizaci\'on aplicada tras la primera ventana de \texttt  {BALANCE\_TIMEOUT}: \texttt  {cpu\_bound} (PID~644) sube a \texttt  {PRI=8} al haber agotado quantums de forma sostenida. El proceso \texttt  {interactive} permanece en prioridad base (\texttt  {PRI=7}) sin penalizaci\'on.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:penalty1}{{3}{13}{Inicio de los tests de validaci\'on y primera penalizaci\'on aplicada tras la primera ventana de \texttt {BALANCE\_TIMEOUT}: \texttt {cpu\_bound} (PID~644) sube a \texttt {PRI=8} al haber agotado quantums de forma sostenida. El proceso \texttt {interactive} permanece en prioridad base (\texttt {PRI=7}) sin penalizaci\'on}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Penalizaci\'on m\'axima alcanzada 5~segundos despu\'es: \texttt  {cpu\_bound} (PID~644) escala a \texttt  {PRI=15} (\texttt  {MIN\_USER\_Q}, techo del rango de usuario), acaparando el 44.73\% de CPU (\texttt  {WCPU=89.44\%}) con la peor prioridad posible. La carga de usuario sube al 100\%. El proceso \texttt  {interactive} sigue sin penalizaci\'on (\texttt  {PRI=7}), confirmando que el mecanismo discrimina correctamente entre ambos tipos de proceso.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:penalty2}{{4}{13}{Penalizaci\'on m\'axima alcanzada 5~segundos despu\'es: \texttt {cpu\_bound} (PID~644) escala a \texttt {PRI=15} (\texttt {MIN\_USER\_Q}, techo del rango de usuario), acaparando el 44.73\% de CPU (\texttt {WCPU=89.44\%}) con la peor prioridad posible. La carga de usuario sube al 100\%. El proceso \texttt {interactive} sigue sin penalizaci\'on (\texttt {PRI=7}), confirmando que el mecanismo discrimina correctamente entre ambos tipos de proceso}{figure.4}{}}
