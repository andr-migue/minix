\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Primera penalizaci\'on aplicada: el proceso \texttt  {cpu\_bound} (PID~644) aparece con \texttt  {NICE=8}, un nivel por encima de la prioridad base. El proceso \texttt  {interactive} mantiene su prioridad original.}}{14}{figure.3}\protected@file@percent }
\newlabel{fig:penalty1}{{3}{14}{Primera penalizaci\'on aplicada: el proceso \texttt {cpu\_bound} (PID~644) aparece con \texttt {NICE=8}, un nivel por encima de la prioridad base. El proceso \texttt {interactive} mantiene su prioridad original}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Penalizaci\'on m\'axima alcanzada: el proceso \texttt  {cpu\_bound} (PID~644) sube a \texttt  {NICE=15} (\texttt  {MIN\_USER\_Q}, techo del rango de usuario), consumiendo el 44.73\% de MCPU con la peor prioridad posible. La carga de usuario sube al 100\%. El proceso \texttt  {interactive} no aparece penalizado.}}{15}{figure.4}\protected@file@percent }
\newlabel{fig:penalty2}{{4}{15}{Penalizaci\'on m\'axima alcanzada: el proceso \texttt {cpu\_bound} (PID~644) sube a \texttt {NICE=15} (\texttt {MIN\_USER\_Q}, techo del rango de usuario), consumiendo el 44.73\% de MCPU con la peor prioridad posible. La carga de usuario sube al 100\%. El proceso \texttt {interactive} no aparece penalizado}{figure.4}{}}
