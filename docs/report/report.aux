\newlabel{fig:baseline}{{1}{13}{Estado inicial del sistema antes de lanzar los procesos de prueba. Todos los procesos de usuario se encuentran en prioridad base (\texttt {NICE=7}). La CPU se muestra mayoritariamente ociosa}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Sistema con los procesos de prueba en ejecuci\'on. El proceso \texttt  {cpu\_bound} comienza a consumir tiempo de CPU de forma sostenida.}}{14}{figure.2}\protected@file@percent }
